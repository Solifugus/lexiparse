  "license": "GPL-2.0-only",
  "bugs": {
    "url": "https://github.com/Solifugus/lexiparse/issues"
  },
  "homepage": "https://github.com/Solifugus/lexiparse#readme",
  "dependencies": {
    "prompt-sync": "^4.1.6"
  }
}
